<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="בחירת מקור לשיר"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnFileExplorer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📂 בחר קובץ דרך מסייר הקבצים"
        android:padding="14dp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnMediaLibrary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎵 ספריית שירים (אמנים, אלבומים וחיפוש)"
        android:padding="14dp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnWebSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🌐 חיפוש והורדה מהאינטרנט (WebView)"
        android:padding="14dp"/>

</LinearLayout>
