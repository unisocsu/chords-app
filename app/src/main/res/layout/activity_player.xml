<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayoutPlayer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/btnOpenMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙️ תפריט אפשרויות"
            android:layout_marginBottom="12dp"/>

        <ScrollView
            android:id="@+id/scrollViewSong"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#FAFAFA"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvSongContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="טוען אקורדים ומילים..."
                android:textSize="18sp"
                android:lineSpacingExtra="8dp"/>
        </ScrollView>

    </LinearLayout>

    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@android:color/white"
        android:orientation="vertical"
        android:padding="16dp"
        android:elevation="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="הגדרות נגן חבילה"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <Switch
            android:id="@+id/switchAutoScrollTempo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="גלילה אוטומטית לפי קצב"
            android:layout_marginBottom="16dp"/>

        <Switch
            android:id="@+id/switchVoiceSync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="גלילה לפי זיהוי שירה (מיקרופון)"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="טרנספוזיציה (שינוי סולם):"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnTransposeDown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"/>

            <TextView
                android:id="@+id/tvTransposeValue"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="0"
                android:textSize="16sp"/>

            <Button
                android:id="@+id/btnTransposeUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnPlayAudio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▶️ נגן שיר ברקע מהחבילה"/>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
